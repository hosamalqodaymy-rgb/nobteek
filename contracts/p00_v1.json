  "command_envelope": {
    "headers": [
      "Idempotency-Key",
      "If-Match"
    ],
    "request_context": "server_resolved_membership_never_body_clinic_id",
    "response_fields": [
      "id",
      "state",
      "version",
      "server_time",
      "request_id"
    ],
    "create_without_aggregate_version": [
      "request",
      "walk_in"
    ],
    "unknown_resource_and_other_clinic_share_404": true,
    "anonymous_idempotency_scope": "server-issued short-lived anonymous session, independent for each browser; never a shared public actor key",
    "sensitive_replay_response_storage": "encrypted at rest with limited retention; no plaintext ticket secrets in logs or persistent replay records",
    "replay_order": [
      "authenticate",
      "authorize_current_scope",
      "lookup_key_and_fingerprint",
      "return_prior_success_or_check_version",
      "atomic_command",
      "commit_event_and_outbox"
    ],
    "idempotency_retention": "at least 48 hours for command results; permanent unique visit and financial constraints remain independent"
  },
  "private_ticket_fields": [
    "booking_state",
    "visit_state",
    "ticket_number",
