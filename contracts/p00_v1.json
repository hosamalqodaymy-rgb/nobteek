    {
      "id": "D01",
      "decision_ar": "اعتماد نوافذ وصول وترتيب حضور؛ لا وعد بدقيقة كشف.",
      "reason_ar": "مدة الزيارات متغيرة ويجب أن يتطابق الوعد مع التشغيل."
    },
    {
      "id": "D02",
      "decision_ar": "رقم الدور ثابت وموضع الانتظار منفصل.",
      "reason_ar": "عودة الغائب والاستثناء المخول لا يعيدان ترقيم التذاكر."
    },
    {
      "id": "D03",
      "decision_ar": "بدء النافذة حد قبول الوصول المبكر، والسعة الإجمالية مشتقة.",
      "reason_ar": "منع تناقض نافذة الوصول مع الدور أو حقلين مختلفين للسعة."
    },
    {
      "id": "D04",
      "decision_ar": "من حضر قبل نهاية الاستقبال يستكمل بعد النهاية؛ الإدخال الجديد يتوقف.",
      "reason_ar": "حفظ استمرارية الخدمة مع إغلاق منفذ الحجوزات الجديدة."
    },
    {
      "id": "D05",
      "decision_ar": "الهاتف اختياري للحضور المباشر ولا يستخدم كمفتاح شخص.",
      "reason_ar": "دعم الأسرة والمراجع الذي لا يملك هاتفا."
    },
    {
      "id": "D06",
      "decision_ar": "الأولوية للطبيب والاستدعاء المفوض منفصل عن بدء الزيارة.",
      "reason_ar": "تحديد المسؤولية ومنع تحول التفويض الإداري إلى قرار طبي."
    },
    {
      "id": "D07",
      "decision_ar": "اختبارات P00 على مرجع داخل الذاكرة وتظل اختبارات التطبيق لاحقة.",
      "reason_ar": "توثيق الدليل الفعلي دون نسبة ضمانات قاعدة أو واجهة إلى نموذج القواعد."
    },
    {
      "id": "D08",
      "decision_ar": "كل ربط أو شراء مدفوع في P13؛ أسماء الحالات المالية محجوزة فقط.",
      "reason_ar": "الالتزام بترتيب التنفيذ المطلوب دون بناء الجداول والتحصيل مبكرا."
    }
  ],
