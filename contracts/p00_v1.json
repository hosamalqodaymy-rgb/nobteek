  "rules": [
    {
      "id": "R01",
      "owner_phase": "P06",
      "text_ar": "طلب الويب معلق ولا يحجز سعة ولا يمنح رقما للدور."
    },
    {
      "id": "R02",
      "owner_phase": "P06",
      "text_ar": "التأكيد وحده يحجز مكانا؛ المؤكد والمستوفى يستهلكان السعة."
    },
    {
      "id": "R03",
      "owner_phase": "P05",
      "text_ar": "نوافذ الوصول داخل جلسة محلية ليوم واحد ولا تتداخل؛ السعة الكلية مجموع سعات النوافذ."
    },
    {
      "id": "R04",
      "owner_phase": "P06",
      "text_ar": "لا يمكن تأكيد طلبين على آخر مكان؛ الحسم في معاملة قاعدة البيانات لاحقا."
    },
    {
      "id": "R05",
      "owner_phase": "P07",
      "text_ar": "رقم تذكرة واحد ثابت لكل وصول، فريد داخل الجلسة ولا يعاد استخدامه."
    },
    {
      "id": "R06",
      "owner_phase": "P07",
      "text_ar": "ترتيب الانتظار مستقل عن رقم التذكرة، والمرجع ترتيب معاملات الخادم."
    },
    {
      "id": "R07",
      "owner_phase": "P07",
      "text_ar": "يدخل الدور من سجل حضوره، وفق الوصول الفعلي؛ مصدر الحجز والدفع لا يمنحان أولوية."
    },
    {
      "id": "R08",
      "owner_phase": "P07",
      "text_ar": "الوصول قبل بدء النافذة لا يمنح دورا؛ يمكن تغيير النافذة قبل الوصول إذا وجدت سعة."
    },
    {
      "id": "R09",
      "owner_phase": "P07",
      "text_ar": "الوصول المتأخر يقبل إلى نهاية استقبال الجلسة بترتيب الحضور الفعلي ولا يلغى الحجز تلقائيا."
    },
    {
      "id": "R10",
      "owner_phase": "P08",
      "text_ar": "المستدعى وداخل الكشف يحجزان الطبيب؛ زيارة واحدة فقط في إحدى الحالتين لكل معرف طبيب."
    },
    {
      "id": "R11",
      "owner_phase": "P08",
      "text_ar": "لا يبدأ الكشف إلا بعد الاستدعاء ولا يكتمل إلا بعد البدء؛ تحفظ أوقات الخادم."
    },
    {
      "id": "R12",
      "owner_phase": "P07",
      "text_ar": "الغائب مؤقتا يخرج من المنتظرين؛ يعود إلى آخر المنتظرين مع حفظ رقم التذكرة."
    },
    {
      "id": "R13",
      "owner_phase": "P08",
      "text_ar": "الأولوية الطبية قرار الطبيب المخول لجلسته، بسبب إداري ثابت دون تشخيص أو تجاوز للحالة النشطة."
    },
    {
      "id": "R14",
      "owner_phase": "P06",
      "text_ar": "الإلغاء قبل بدء الزيارة يحرر السعة ويغلق الوصول المرتبط إن وجد؛ يحتفظ برقمه وسجله."
    },
    {
      "id": "R15",
      "owner_phase": "P06",
      "text_ar": "بعد بدء الزيارة يعالج الطبيب إنهاءها وتصحيحها بسجل؛ لا يستخدم إلغاء حجز عادي."
    },
    {
      "id": "R16",
      "owner_phase": "P06",
      "text_ar": "التعديل بين نافذتين أو جلستين ذري؛ إن امتلأت الجديدة تبقى القديمة كما هي، وبعد الوصول تستخدم إجراءات الدور."
    },
    {
      "id": "R17",
      "owner_phase": "P05",
      "text_ar": "إيقاف الجلسة يمنع استدعاء جديد، ويقبل وصولا ضمن الوقت ويسمح بإتمام الحالة الجارية."
    },
    {
      "id": "R18",
      "owner_phase": "P05",
      "text_ar": "عند نهاية الاستقبال تتوقف الحجوزات والوصول الجديد؛ تستكمل قائمة من حضروا سابقا حتى معالجتها وإغلاقها."
    },
    {
      "id": "R19",
      "owner_phase": "P05",
      "text_ar": "الإغلاق يتطلب معالجة المنتظر والغائب والمستدعى وداخل الكشف؛ لا يحول غير الواصل إلى متغيب تلقائيا."
    },
    {
      "id": "R20",
      "owner_phase": "P05",
      "text_ar": "تمديد نهاية الاستقبال داخل اليوم يحتاج صلاحية وسببا؛ لا يضيف نوافذ أو سعة تلقائيا."
    },
    {
      "id": "R21",
      "owner_phase": "P05",
      "text_ar": "خفض السعة دون عدد الحجوزات المؤكدة والمستوفاة مرفوض؛ الزيادة أو الخفض المسموح يسجلان بسبب."
    },
    {
      "id": "R22",
      "owner_phase": "P04",
      "text_ar": "اختيار سياق العيادة من عضوية موثوقة في الخادم؛ لا تعتمد العيادة على حقل يرسله العميل."
    },
    {
      "id": "R23",
      "owner_phase": "P04",
      "text_ar": "صلاحيات الطبيب مقيدة بجلساته، ومالك المنصة لا يطلع افتراضيا على بيانات المراجعين."
    },
    {
      "id": "R24",
      "owner_phase": "P04",
      "text_ar": "استدعاء الاستقبال صلاحية تفويض صريحة معطلة افتراضيا؛ بدء الزيارة وإنهاؤها للطبيب."
    },
    {
      "id": "R25",
      "owner_phase": "P04",
      "text_ar": "أسماء دخول وكلمات مرور للموظفين؛ تحقق إضافي للمالكين قبل التشغيل الحقيقي واستعادة تبطل الجلسات القديمة."
    },
    {
      "id": "R26",
      "owner_phase": "P06",
      "text_ar": "الهاتف المشترك لا يدمج أفراد الأسرة ولا يحذف حجوزاتهم؛ المعرف الداخلي هو المرجع."
    },
    {
      "id": "R27",
      "owner_phase": "P06",
      "text_ar": "تطبع الأرقام العربية والإنجليزية إلى جوال يمني من تسعة أرقام يبدأ بسبعة؛ هذا تحقق شكلي لا يثبت الملكية."
    },
    {
      "id": "R28",
      "owner_phase": "P07",
      "text_ar": "هاتف المراجع المباشر اختياري، واسم عرضه مطلوب؛ طلب الويب والهاتف يحتاجان رقم تواصل."
    },
    {
      "id": "R29",
      "owner_phase": "P09",
      "text_ar": "الرابط سر عشوائي مستقل عن التذكرة، تخزن بصمته؛ ينتهي بعد 48 ساعة من نهاية الجلسة ويجدد بإبطال القديم عند الاستعادة."
    },
    {
      "id": "R30",
      "owner_phase": "P09",
      "text_ar": "لا استرجاع للهاتف وحده ولا كشف لقائمة حجوزات الأسرة؛ تعرض التذكرة حقولا محدودة دون أسماء أو هواتف الآخرين."
    },
    {
      "id": "R31",
      "owner_phase": "P09",
      "text_ar": "العدد أمام المراجع يشمل المنتظرين الحاضرين السابقين فقط؛ انشغال الطبيب يعرض منفصلا دون وعد بوقت كشف."
    },
    {
      "id": "R32",
      "owner_phase": "P09",
      "text_ar": "شاشة الصالة تعرض الأرقام ومعرف الطبيب فقط؛ لا أسماء مراجعين ولا هواتف."
    },
    {
      "id": "R33",
      "owner_phase": "P06",
      "text_ar": "كل أمر تعديل يحمل مفتاح منع تكرار ونسخة متوقعة؛ تكرار المفتاح بمحتوى مختلف يرفض، وتراجع الصلاحية عند إعادة النتيجة."
    },
    {
      "id": "R34",
      "owner_phase": "P11",
      "text_ar": "انقطاع الاتصال لا يؤكد الحفظ؛ تتوقف الأوامر وتوضح قدم المعلومة ويستخدم البديل الورقي ثم المطابقة."
    },
    {
      "id": "R35",
      "owner_phase": "P09",
      "text_ar": "تخزن ملفات الواجهة الثابتة فقط؛ الروابط والبيانات الخاصة مستبعدة من التخزين المشترك والتحليلات وسجلات الأسرار."
    },
    {
      "id": "R36",
      "owner_phase": "P10",
      "text_ar": "سجل الأحداث وصندوق الإرسال يثبتان بعد نجاح المعاملة؛ يفشل التراجع كله دون رسالة أو حدث جزئي."
    },
    {
      "id": "R37",
      "owner_phase": "P10",
      "text_ar": "الإرسال الخارجي معطل قبل P13؛ المحاكي لا يسجل تسليما حقيقيا."
    },
    {
      "id": "R38",
      "owner_phase": "P10",
      "text_ar": "الانتظار يقاس من الوصول إلى بدء الكشف للزيارات مكتملة الأوقات؛ تعرض الأوقات الناقصة والمغادرون منفصلين."
    },
    {
      "id": "R39",
      "owner_phase": "P11",
      "text_ar": "تحفظ البيانات بتواريخ UTC وتعرض بتوقيت Asia/Aden، وتفحص الاستعادة في بيئة منفصلة قبل البيانات الحقيقية."
    },
    {
      "id": "R40",
      "owner_phase": "P13",
      "text_ar": "الأسعار والجداول المالية والتحصيل وربط المزودين وشراء الخدمات تنفذ أخيرا؛ لا يغير التحصيل ترتيب الدور."
    },
    {
      "id": "R41",
      "owner_phase": "P12",
      "text_ar": "الاختبارات المرجعية في P00 لا تثبت عمل التطبيق أو قاعدة البيانات أو الأمن أو نجاح السوق."
    },
    {
      "id": "R42",
      "owner_phase": "P11",
      "text_ar": "الحذف والاحتفاظ والتصدير بقرار مصرح وسياسة متفق عليها قبل الاستخدام الحقيقي؛ لا حذف نهائي تلقائي بمدة مفترضة."
    },
    {
      "id": "R43",
      "owner_phase": "P05",
      "text_ar": "جلسات الطبيب نفسه داخل العيادة لا تتداخل، ويبقى منع إشغال الطبيب بزيارتين ساريا عند امتداد العمل لجلسة لاحقة."
    },
    {
      "id": "R44",
      "owner_phase": "P06",
      "text_ar": "طلبات الزوار تستخدم نطاق إعادة محاولة مستقلا لكل جلسة زائر قصيرة؛ لا يشترك جميع الزوار في مفتاح عام يعيد رابط شخص آخر."
    }
  ],
